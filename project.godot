; Engine configuration file.
; Projet Godot 4 — Bloomward (prototype).

config_version=5

[application]

config/name="Bloomward"
config/description="Prototype jouable de Bloomward : une petite zone à restaurer, à un ou deux joueurs en réseau local."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[network]

limits/debugger/max_chars_per_second=32768

[rendering]

anti_aliasing/quality/msaa_3d=2

[shader_globals]

bloom_radius={
"type": "float",
"value": 0.0
}
bloom_center={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
